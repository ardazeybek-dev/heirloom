# heirloom CLI defaults — copy to .env (never commit .env).
# Command-line flags override these values. Never put the secret itself here.

# Cards needed to recover the secret (-k / --threshold)
HEIRLOOM_THRESHOLD=3

# Cards to make (-n / --shares)
HEIRLOOM_SHARES=5

# QR error-correction level: L (7%), M (15%), Q (25%), H (30%)
HEIRLOOM_QR_LEVEL=M

# Paper size of the printable sheet: a4 or letter
HEIRLOOM_PAPER=a4

# Recovery address printed on every card — point it at your own hosted copy if you have one
HEIRLOOM_RECOVERY_URL=ardazeybek-dev.github.io/heirloom

# Set to any value to disable coloured terminal output
# NO_COLOR=1
